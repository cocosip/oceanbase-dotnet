root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = tab
indent_size = 4

[*.{csproj,props,targets,slnx,xml,config}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 重建自反编译产物，暂不启用风格分析器（会与原始代码风格冲突）
dotnet_analyzer_diagnostic.category-Style.severity = none

# 重建代码沿用原命名（含 m_ 前缀私有字段），不强制 .NET 默认命名规则
dotnet_naming_rule.instance_fields_should_be_camel_case.severity = none
dotnet_naming_rule.private_fields_should_be_camel_case.severity = none

# 使用显式类型而非 var 会与重建代码大量冲突，保持宽松
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = false:silent
csharp_style_var_elsewhere = false:silent
